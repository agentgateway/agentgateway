            "image_url": {
              "url": "data:image/png;base64,iVBORw0KGgo=",
              "detail": "original"
            }
          },
          {
            "type": "text",
            "text": "Now compare it to this one."
          }
        ]
      }
    ],
    "model": "gpt-4o",
    "stream": false
  },
  "parsed": {
    "input_format": "Responses",
    "cache_convention": "InputIncludesCache",
