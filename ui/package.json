{
  "name": "agentgateway-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.17.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "VITE_AGENTGATEWAY_API=http://localhost:15000 vite --host 0.0.0.0 --port 19000",
    "build": "pnpm generate-schema && tsc -b && vite build",
    "lint": "pnpm typecheck && pnpm format:check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm generate-schema && tsc -b",
    "preview": "vite preview --host 0.0.0.0 --port 19001",
    "generate-schema": "node scripts/generate-schema.mjs",
    "preview:e2e": "VITE_BASE_PATH=/ VITE_E2E=true vite build && vite preview --host 127.0.0.1 --port 19100",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/fira-code": "=5.2.7",
    "@fontsource/geist-sans": "=5.2.5",
    "@monaco-editor/react": "=4.7.0",
    "@number-flow/react": "=0.6.0",
    "@tanstack/react-query": "=5.101.0",
    "@tanstack/react-router": "=1.170.15",
    "js-yaml": "=4.3.1",
    "lucide-react": "=0.562.0",
    "monaco-editor": "=0.53.0",
    "monaco-yaml": "=5.5.1",
    "react": "=19.2.7",
    "react-dom": "=19.2.7",
    "recharts": "=3.8.1",
    "zod": "=4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "=1.60.0",
    "@types/js-yaml": "=4.0.9",
    "@types/node": "=24.13.3",
    "@types/react": "=19.2.17",
    "@types/react-dom": "=19.2.3",
    "@vitejs/plugin-react": "=5.2.0",
    "ajv": "=8.20.0",
    "json-schema-to-typescript": "=15.0.4",
    "typescript": "=7.0.2",
    "vite": "=8.0.16"
  }
}
