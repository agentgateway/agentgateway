#!/bin/sh
if [ $# -lt 1 ]; then
  echo "usage: $0 <go-tool-package> [args...]" >&2
  exit 2
fi

WD=$(cd "$(dirname "$0")"; pwd)

if [ -n "${GOCACHEPROG:-}" ]; then
  # Keep each package's executable, preserving its name for generated-code headers.
  # Key the path on the tool versions so bumps trigger a rebuild.
  VERSION=$(cat "$WD/go.mod" "$WD/go.sum" | cksum | cut -d' ' -f1)
  TOOL="$WD/.bin/$VERSION/$1"
  if [ ! -x "$TOOL" ]; then
    mkdir -p "$(dirname "$TOOL")" || exit 1
    # Build to a temporary path so concurrent callers never exec a partial binary.
    (cd "$WD" && go build -o "$TOOL.$$" "$1") || exit $?
    mv -f "$TOOL.$$" "$TOOL" || exit 1
  fi
else
  TOOL=$(cd "$WD"; go tool -n "$1") || exit $?
fi
shift
exec "$TOOL" "$@"
