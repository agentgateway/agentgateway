---
source: crates/llm/src/ir_golden_tests.rs
description: src/tests/requests/messages/responses_agent_subset.json
info:
  model: claude-sonnet-4-20250514
  max_tokens: 256
  system:
    - type: text
      text: You are a reliable tool-using assistant.
    - type: text
      text: Return compact JSON when asked.
  thinking:
    type: adaptive
  output_config:
    effort: medium
    format:
      type: json_schema
      schema:
        type: object
        properties:
          answer:
            type: string
        required:
          - answer
        additionalProperties: false
  metadata:
    user_id: user-123
    trace_id: trace-abc
  tools:
    - name: get_weather
      description: Get the current weather in a given location
      input_schema:
        type: object
        properties:
          location:
            type: string
        required:
          - location
  tool_choice:
    type: tool
    name: get_weather
    disable_parallel_tool_use: true
  messages:
    - role: user
      content:
        - type: text
          text: "What is in these images, then check the weather?"
        - type: image
          source:
            type: base64
            media_type: image/png
            data: aGVsbG8=
        - type: image
          source:
            type: url
            url: "https://example.com/image.png"
        - type: image
          source:
            type: file
            file_id: file_abc123
    - role: assistant
      content:
        - type: tool_use
          id: call_weather
          name: get_weather
          input:
            location: San Francisco
    - role: user
      content:
        - type: tool_result
          tool_use_id: call_weather
          content:
            - type: text
              text: Sunny and 65F.
---
