---
source: crates/llm/src/golden_tests.rs
description: src/tests/requests/messages/cache_control_automatic.json
info:
  model: claude-sonnet-4-5
  max_tokens: 1024
  cache_control:
    type: ephemeral
    ttl: 1h
  system: You are helpful.
  messages:
    - role: user
      content: Hello
---
{
  "request": {
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "text": "Hello"
          },
          {
            "cachePoint": {
              "ttl": "1h",
              "type": "default"
            }
          }
        ]
      }
    ],
    "system": [
      {
        "text": "You are helpful."
      }
    ],
    "inferenceConfig": {
      "maxTokens": 1024
    }
  },
  "parsed": {
    "input_format": "Messages",
    "cache_convention": "InputIncludesCache",
    "request_model": "claude-sonnet-4-5",
    "provider": "bedrock",
    "streaming": false,
    "params": {
      "max_tokens": 1024
    },
    "prompt": [
      {
        "role": "system",
        "content": "You are helpful."
      },
      {
        "role": "user",
        "content": "Hello"
      }
    ]
  }
}
