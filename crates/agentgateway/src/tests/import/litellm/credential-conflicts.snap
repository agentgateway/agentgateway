---
source: crates/agentgateway/src/import.rs
description: src/tests/import/litellm/credential-conflicts.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: overridden
        provider: openAI
        params:
          baseUrl: "https://override.example/v1"
          apiKey: $OPENAI_API_KEY
          model: gpt-4o
      - name: missing
        provider: openAI
        params:
          model: gpt-4o-mini
      - name: ambiguous
        provider: openAI
        params:
          model: gpt-4.1
      - name: unsupported
        provider: azure
        params:
          model: gpt-4.1
findings:
  - sourcePath: "credential_list[4].credential_values.azure_ad_token"
    status: manual
    message: LiteLLM credential value requires manual review and was not emitted
  - sourcePath: "credential_list[2].credential_name"
    status: unsupported
    message: "LiteLLM credential name \"duplicate\" is duplicated and cannot be resolved safely"
  - sourcePath: "credential_list[3].credential_name"
    status: unsupported
    message: "LiteLLM credential name \"duplicate\" is duplicated and cannot be resolved safely"
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for overridden
  - sourcePath: "credential_list[0]"
    status: exact
    message: "Imported supported values from LiteLLM credential \"shared-openai\""
  - sourcePath: "model_list[0].litellm_params.litellm_credential_name"
    status: approximate
    message: "Applied LiteLLM credential \"shared-openai\" inline because model-level provider parameters override the shared credential"
  - sourcePath: "model_list[1]"
    status: exact
    message: Imported model deployment for missing
  - sourcePath: "model_list[1].litellm_params.litellm_credential_name"
    status: unsupported
    message: "LiteLLM credential \"missing\" is not defined and was not applied"
  - sourcePath: "model_list[2]"
    status: exact
    message: Imported model deployment for ambiguous
  - sourcePath: "model_list[2].litellm_params.litellm_credential_name"
    status: unsupported
    message: "LiteLLM credential \"duplicate\" is duplicated and was not applied"
  - sourcePath: "model_list[3]"
    status: exact
    message: Imported model deployment for unsupported
  - sourcePath: "model_list[3].litellm_params.litellm_credential_name"
    status: manual
    message: "LiteLLM credential \"unsupported-values\" contains no supported provider values and was not applied"
  - sourcePath: "credential_list[1]"
    status: manual
    message: "LiteLLM credential \"unused\" is not referenced by an imported model and was not emitted"
