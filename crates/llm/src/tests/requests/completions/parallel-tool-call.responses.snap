          }
        ]
      },
      {
        "type": "function_call",
        "call_id": "call_1",
        "name": "get_weather",
        "arguments": "{\"location\":\"Columbus, OH\"}",
        "status": "completed"
      },
      {
        "type": "function_call",
        "call_id": "call_2",
        "name": "get_weather",
        "arguments": "{\"location\":\"New York, NY\"}",
        "status": "completed"
      },
      {
        "type": "function_call_output",
        "call_id": "call_1",
        "output": "{ \"temperature\": 15, \"condition\": \"Cloudy\" }",
        "status": "completed"
      },
      {
        "type": "function_call_output",
        "call_id": "call_2",
