{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"root": "..",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			// Root configuration, source, scripts, & tests
			"src/**/*.{ts,tsx,css}",
			"tests/**/*.ts",
			"scripts/**/*.mjs",
			"*.{ts,js,json,jsonc,html}",
			// Generated by `pnpm generate-schema`
			"!src/cel.d.ts",
			"!src/gateway-admin.d.ts",
			"!src/gateway-config.d.ts"
		]
	},
	"formatter": {
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "none",
			"arrowParentheses": "asNeeded"
		}
	},
	"css": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"rules": {
			"preset": "none"
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.{ts,tsx}"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["./**", "../**"],
										"message": "Use the configured @/ alias instead of relative imports."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"preset": "none",
			"source": {
				"noDuplicateClasses": "on",
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [":NODE:", ":PACKAGE:", ":BLANK_LINE:", [":ALIAS:", ":PATH:"]],
						"sortBareImports": false
					}
				},
				"useSortedPackageJson": "on"
			}
		}
	}
}
