---
source: crates/llm/src/golden_tests.rs
description: src/tests/requests/decisions/history.json
info:
  model: gemini-decision-1
  input:
    - type: message
      role: developer
      content: You review support tickets.
    - role: system
      content:
        - type: input_text
          text: Refunds are allowed within 30 days.
        - type: input_text
          text: Escalate repeat issues.
    - type: message
      content: My order arrived with a cracked screen.
    - role: assistant
      content: Sorry about that. When did it arrive?
    - role: user
      content:
        - type: input_text
          text: Yesterday. I want my money back.
        - type: input_json
          data:
            order_id: A-1001
    - type: function_call
      call_id: call_1
      namespace: orders
      name: lookup
      arguments: "{\"order_id\":\"A-1001\"}"
    - type: function_call_output
      call_id: call_1
      output:
        - type: input_text
          text: "{\"delivered\":\"yesterday\",\"previous_claims\":1}"
        - type: input_text
          text: Screen damage photo attached to the claim.
    - type: custom_tool_call
      call_id: call_2
      name: policy_search
      input: refund window
    - type: custom_tool_call_output
      call_id: call_2
      output: 30 days from delivery
    - role: assistant
      phase: final_answer
      content:
        - type: output_text
          text: A refund has been requested.
        - type: refusal
          refusal: "I can't share internal fraud scores."
  questions:
    - type: predicate
      name: refund
      instructions: Is the customer asking for a refund?
---
{
  "request": {
    "model": "gemini-decision-1",
    "input": [
      {
        "type": "text",
        "text": "developer:\nYou review support tickets.\n\nsystem:\nRefunds are allowed within 30 days.\nEscalate repeat issues.\n\nuser:\nMy order arrived with a cracked screen.\n\nassistant:\nSorry about that. When did it arrive?\n\nuser:\nYesterday. I want my money back.\n{\"order_id\":\"A-1001\"}\n\nfunction call orders.lookup (call_id call_1):\n{\"order_id\":\"A-1001\"}\n\nfunction call output (call_id call_1):\n{\"delivered\":\"yesterday\",\"previous_claims\":1}\nScreen damage photo attached to the claim.\n\ncustom tool call policy_search (call_id call_2):\nrefund window\n\ncustom tool call output (call_id call_2):\n30 days from delivery\n\nassistant:\nA refund has been requested.\n(refusal) I can't share internal fraud scores."
      }
    ],
    "questions": {
      "q_0": {
        "type": "noul",
        "instructions": "Is the customer asking for a refund?"
      }
    }
  },
  "parsed": {
    "input_format": "Decisions",
    "cache_convention": "InputIncludesCache",
    "request_model": "gemini-decision-1",
    "provider": "gemini",
    "streaming": false,
    "params": {}
  }
