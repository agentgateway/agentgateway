---
source: crates/agentgateway/src/import/litellm.rs
description: src/tests/import/litellm/db-state-mcp-restricted-static-headers.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: chat
        provider: openAI
        params:
          model: gpt-4o
    policies:
      apiKey:
        keys:
          - key: sk-test-master-key
            metadata:
              name: master
          - keyHash: "sha256:ffddeaab67e8d27315df79fb0e65f3eb8174ff16ebceec0bd6ea68fd6f55072b"
            metadata:
              name: granted-key
        mode: strict
  mcp:
    gateways: default
    targets:
      - mcp:
          host: "http://mcp-test-server:8081/mcp"
        policies:
          requestHeaderModifier:
            set:
              x-upstream-token: $UPSTREAM_TOKEN
        name: restricted-tools
    policies:
      apiKey:
        keys:
          - keyHash: "sha256:ffddeaab67e8d27315df79fb0e65f3eb8174ff16ebceec0bd6ea68fd6f55072b"
            metadata:
              name: granted-key
          - key: sk-test-master-key
            metadata:
              name: master
        mode: strict
      mcpAuthorization:
        rules:
          - "apiKey.name == \"granted-key\" && ((has(mcp.tool) && mcp.tool.target == \"restricted-tools\") || (has(mcp.prompt) && mcp.prompt.target == \"restricted-tools\") || (has(mcp.resource) && mcp.resource.target == \"restricted-tools\"))"
          - "apiKey.name == \"master\""
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: general_settings.master_key
    status: approximate
    message: "Mapped LiteLLM's master_key (an admin-equivalent credential, not a per-user virtual key) to strict Authorization Bearer authentication; LiteLLM also accepts other credential headers. Per-user virtual-key migration needs LiteLLM's database state, not config.yaml alone."
  - sourcePath: mcp_servers.restricted_tools
    status: approximate
    message: "Renamed \"restricted_tools\" to \"restricted-tools\" to satisfy agentgateway's Gateway-API-style MCP target name pattern (lowercase letters, digits, '-', '.'; no underscores)"
  - sourcePath: mcp_servers.restricted_tools
    status: exact
    message: Mapped static_headers to a fixed request header modifier on this target
  - sourcePath: mcp_servers.restricted_tools
    status: unsupported
    message: "This server is restricted to specific virtual keys via DB-managed object_permission.mcp_servers grants, which config.yaml alone cannot express; it was not emitted rather than exposing it to every caller"
  - sourcePath: "db_state.keys[0]"
    status: exact
    message: "Migrated key \"granted-key\" to llm.policies.apiKey (hash-based, no plaintext)"
  - sourcePath: db_state.mcp_servers.restricted-tools
    status: approximate
    message: "Emitted MCP target \"restricted-tools\", held back because config.yaml set allow_all_keys: false, which it alone cannot express safely, now restored by a real mcpAuthorization grant"
