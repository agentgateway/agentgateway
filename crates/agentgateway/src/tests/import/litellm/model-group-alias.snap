---
source: crates/agentgateway/src/import.rs
description: src/tests/import/litellm/model-group-alias.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: single
        provider: openAI
        params:
          model: gpt-4o-mini
      - name: imported/litellm/weighted/1
        visibility: internal
        provider: openAI
        params:
          model: gpt-4o
      - name: imported/litellm/weighted/2
        visibility: internal
        provider: anthropic
        params:
          model: claude-sonnet-4
      - name: imported/litellm/primary/1
        visibility: internal
        provider: openAI
        params:
          model: gpt-4o
      - name: backup
        provider: anthropic
        params:
          model: claude-haiku-4
    virtualModels:
      - name: weighted
        routing:
          weighted:
            targets:
              - model: imported/litellm/weighted/1
                weight: 1
              - model: imported/litellm/weighted/2
                weight: 1
      - name: primary
        routing:
          failover:
            targets:
              - model: imported/litellm/primary/1
                priority: 0
              - model: backup
                priority: 1
      - name: single-alias
        routing:
          weighted:
            targets:
              - model: single
                weight: 1
      - name: weighted-alias
        routing:
          weighted:
            targets:
              - model: imported/litellm/weighted/1
                weight: 1
              - model: imported/litellm/weighted/2
                weight: 1
      - name: failover-alias
        routing:
          failover:
            targets:
              - model: imported/litellm/primary/1
                priority: 0
              - model: backup
                priority: 1
      - name: unknown-field-alias
        routing:
          weighted:
            targets:
              - model: single
                weight: 1
      - name: chain-link
        routing:
          weighted:
            targets:
              - model: imported/litellm/weighted/1
                weight: 1
              - model: imported/litellm/weighted/2
                weight: 1
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for single
  - sourcePath: "model_list[1]"
    status: exact
    message: Imported model deployment for weighted
  - sourcePath: "model_list[2]"
    status: exact
    message: Imported model deployment for weighted
  - sourcePath: "model_list[3]"
    status: exact
    message: Imported model deployment for primary
  - sourcePath: "model_list[4]"
    status: exact
    message: Imported model deployment for backup
  - sourcePath: router_settings.fallbacks
    status: approximate
    message: Mapped ordinary LiteLLM fallbacks to agentgateway priority-based failover
  - sourcePath: router_settings.model_group_alias.hidden-alias.hidden
    status: manual
    message: Hidden LiteLLM model group alias requires manual handling until virtual models can be omitted from discovery
  - sourcePath: router_settings.model_group_alias.unknown-field-alias.description
    status: manual
    message: Unrecognized LiteLLM model group alias field was not emitted
  - sourcePath: router_settings.model_group_alias.single-alias
    status: exact
    message: "Mapped LiteLLM model group alias to imported model group \"single\""
  - sourcePath: router_settings.model_group_alias.weighted-alias
    status: exact
    message: "Mapped LiteLLM model group alias to imported model group \"weighted\""
  - sourcePath: router_settings.model_group_alias.failover-alias
    status: exact
    message: "Mapped LiteLLM model group alias to imported model group \"primary\""
  - sourcePath: router_settings.model_group_alias.unknown-field-alias
    status: exact
    message: "Mapped LiteLLM model group alias to imported model group \"single\""
  - sourcePath: router_settings.model_group_alias.missing-alias
    status: manual
    message: "Model group alias target \"missing\" was not imported"
  - sourcePath: router_settings.model_group_alias.single
    status: unsupported
    message: "Model group alias \"single\" conflicts with an imported model group and was not emitted"
  - sourcePath: router_settings.model_group_alias.weighted
    status: exact
    message: "Model group alias \"weighted\" already names this model group and was not duplicated"
  - sourcePath: router_settings.model_group_alias.chain-alias
    status: unsupported
    message: Model group alias chains are not supported and the alias was not emitted
  - sourcePath: router_settings.model_group_alias.chain-link
    status: exact
    message: "Mapped LiteLLM model group alias to imported model group \"weighted\""
  - sourcePath: router_settings.model_group_alias.cycle-a
    status: unsupported
    message: Model group alias chains are not supported and the alias was not emitted
  - sourcePath: router_settings.model_group_alias.cycle-b
    status: unsupported
    message: Model group alias chains are not supported and the alias was not emitted
