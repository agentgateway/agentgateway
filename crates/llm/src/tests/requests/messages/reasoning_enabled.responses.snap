      content: hello
  thinking:
    type: enabled
    budget_tokens: 1024
---
{
  "request": {
    "input": [
      {
        "type": "message",
        "role": "user",
        "content": [
          {
            "type": "input_text",
            "text": "hello"
          }
        ]
      }
    ],
    "model": "gpt-5.6-luna",
    "max_output_tokens": 2048,
    "stream": false,
    "reasoning": {
      "effort": "low"
    }
  },
  "parsed": {
    "input_format": "Messages",
    "cache_convention": "InputIncludesCache",
    "request_model": "gpt-5.6-luna",
    "provider": "responses",
    "streaming": false,
    "params": {
      "max_tokens": 2048
    },
    "prompt": [
      {
        "role": "user",
        "content": "hello"
      }
    ]
  }
