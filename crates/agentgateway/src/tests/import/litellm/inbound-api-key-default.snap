---
source: crates/agentgateway/src/import.rs
description: src/tests/import/litellm/inbound-api-key-default.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: chat
        provider: openAI
        params:
          model: gpt-4o
    policies:
      apiKey:
        keys:
          - key: $LITELLM_MASTER_KEY
        mode: strict
        location:
          header:
            name: authorization
            prefix: "Bearer "
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: general_settings.master_key
    status: approximate
    message: Mapped LiteLLM master_key to strict Authorization Bearer authentication; LiteLLM also accepts other credential headers
