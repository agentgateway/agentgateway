      cache_control:
        type: ephemeral
        ttl: 1h
  messages:
    - role: assistant
      content:
        - type: text
          text: First assistant block
        - type: text
          text: Second assistant block
          cache_control:
            type: ephemeral
            ttl: 1h
    - role: user
      content:
        - type: text
          text: Cached user text
          cache_control:
            type: ephemeral
            ttl: 5m
        - type: image
          source:
            type: base64
            media_type: image/png
            data: aGVsbG8=
          cache_control:
            type: ephemeral
            ttl: 5m
    - role: assistant
      content:
        - type: tool_use
          id: call_text
          name: lookup
          input: {}
        - type: tool_use
          id: call_array
          name: lookup
          input: {}
        - type: tool_use
          id: call_image
          name: lookup
          input: {}
        - type: tool_use
          id: call_mixed
          name: lookup
          input: {}
          cache_control:
            type: ephemeral
    - role: user
      content:
        - type: tool_result
          tool_use_id: call_text
          content: text result
          cache_control:
            type: ephemeral
        - type: tool_result
          tool_use_id: call_array
          content:
            - type: text
              text: array result
              cache_control:
                type: ephemeral
        - type: tool_result
          tool_use_id: call_image
          content:
            - type: image
              source:
                type: base64
                media_type: image/png
                data: aGVsbG8=
              cache_control:
                type: ephemeral
        - type: tool_result
          tool_use_id: call_mixed
          content:
            - type: text
              text: before image
            - type: image
              source:
                type: base64
                media_type: image/png
                data: aGVsbG8=
              cache_control:
                type: ephemeral
            - type: text
              text: after image
    - role: system
      content:
        - type: text
          text: System-role block
          cache_control:
            type: ephemeral
  tools:
    - name: lookup
      description: Look up information
      input_schema:
        type: object
        properties: {}
      cache_control:
        type: ephemeral
