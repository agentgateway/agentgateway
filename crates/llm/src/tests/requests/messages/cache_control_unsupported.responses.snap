---
source: crates/llm/src/golden_tests.rs
description: src/tests/requests/messages/cache_control_unsupported.json
info:
  model: gpt-5.5
  max_tokens: 1024
  system:
    - type: text
      text: Stable instructions
    - type: text
      text: Cached instructions
      cache_control:
        type: ephemeral
  messages:
    - role: user
      content:
        - type: text
          text: Return CACHE_CONTROL_OK
          cache_control:
            type: ephemeral
---
{
  "request": {
    "input": [
      {
        "type": "message",
        "role": "user",
        "content": [
          {
            "type": "input_text",
            "text": "Return CACHE_CONTROL_OK"
          }
        ]
      }
    ],
    "model": "gpt-5.5",
    "max_output_tokens": 1024,
    "stream": false,
    "instructions": "Stable instructions\nCached instructions"
  },
  "parsed": {
    "input_format": "Messages",
    "cache_convention": "InputIncludesCache",
    "request_model": "gpt-5.5",
    "provider": "responses",
    "streaming": false,
    "params": {
      "max_tokens": 1024
    },
    "prompt": [
      {
        "role": "system",
        "content": "Stable instructions\nCached instructions"
      },
      {
        "role": "user",
        "content": "Return CACHE_CONTROL_OK"
      }
    ]
  }
}
