      {
        "type": "function_call",
        "call_id": "toolu_01",
        "name": "get_weather",
        "arguments": "{\"location\":\"San Francisco, CA\"}",
        "status": "completed"
      },
      {
        "type": "function_call_output",
        "call_id": "toolu_01",
        "output": [
          {
            "type": "input_text",
