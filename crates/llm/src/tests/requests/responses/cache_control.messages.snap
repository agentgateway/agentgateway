---
source: crates/llm/src/golden_tests.rs
description: src/tests/requests/responses/cache_control.json
info:
  model: gpt-5
  input:
    - role: user
      content:
        - type: input_text
          text: Cached user input
          prompt_cache_breakpoint:
            mode: explicit
        - type: input_image
          image_url: "data:image/png;base64,aGVsbG8="
          prompt_cache_breakpoint:
            mode: explicit
        - type: input_file
          file_data: aGVsbG8=
          filename: notes.txt
          prompt_cache_breakpoint:
            mode: explicit
    - role: system
      content:
        - type: input_text
          text: Cached system input
          prompt_cache_breakpoint:
            mode: explicit
    - role: developer
      content:
        - type: input_text
          text: Cached developer input
          prompt_cache_breakpoint:
            mode: explicit
---
{
  "request": {
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Cached user input"
          },
          {
            "type": "image",
            "source": {
              "type": "base64",
              "media_type": "image/png",
              "data": "aGVsbG8="
            }
          },
          {
            "type": "document",
            "source": {
              "type": "text",
              "media_type": "text/plain",
              "data": "hello"
            },
            "title": "notes.txt"
          }
        ]
      }
    ],
    "system": [
      {
        "type": "text",
        "text": "Cached system input"
      },
      {
        "type": "text",
        "text": "Cached developer input"
      }
    ],
    "model": "gpt-5",
    "max_tokens": 4096
  },
  "parsed": {
    "input_format": "Responses",
    "cache_convention": "InputIncludesCache",
    "request_model": "gpt-5",
    "provider": "messages",
    "streaming": false,
    "params": {},
    "prompt": [
      {
        "role": "user",
        "content": "Cached user input"
      },
      {
        "role": "system",
        "content": "Cached system input"
      },
      {
        "role": "developer",
        "content": "Cached developer input"
      }
    ]
  }
}
