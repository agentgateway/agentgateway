---
source: crates/llm/src/golden_tests.rs
description: src/tests/requests/messages/tool_result_image.json
info:
  model: claude-opus-4-6
  max_tokens: 1024
  tools:
    - name: get_weather
      description: Get the current weather in a given location
      input_schema:
        type: object
        properties:
          location:
            type: string
            description: "The city and state, e.g. San Francisco, CA"
        required:
          - location
  messages:
    - role: user
      content: What is the weather like in San Francisco?
    - role: assistant
      content:
        - type: tool_use
          id: toolu_01
          name: get_weather
          input:
            location: "San Francisco, CA"
    - role: user
      content:
        - type: tool_result
          tool_use_id: toolu_01
          content:
            - type: text
              text: "Weather chart:"
            - type: image
              source:
                type: url
                url: "https://example.com/weather.png"
              cache_control:
                type: ephemeral
            - type: image
              source:
                type: base64
                media_type: image/png
                data: iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a2ioAAAAASUVORK5CYII=
            - type: text
              text: Describe the weather chart.
          cache_control:
            type: ephemeral
---
{
  "request": {
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What is the weather like in San Francisco?"
          }
        ]
      },
      {
        "role": "assistant",
        "tool_calls": [
          {
            "type": "function",
            "id": "toolu_01",
            "function": {
              "name": "get_weather",
              "arguments": "{\"location\":\"San Francisco, CA\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "content": [
          {
            "type": "text",
            "text": "Weather chart:"
          },
          {
            "type": "text",
            "text": "Describe the weather chart."
          }
        ],
        "tool_call_id": "toolu_01"
      }
    ],
    "model": "claude-opus-4-6",
    "max_completion_tokens": 1024,
    "stream": false,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Get the current weather in a given location",
          "parameters": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "description": "The city and state, e.g. San Francisco, CA"
              }
            },
            "required": [
              "location"
            ]
          }
        }
      }
    ]
  },
  "parsed": {
    "input_format": "Messages",
    "cache_convention": "InputIncludesCache",
    "request_model": "claude-opus-4-6",
    "provider": "openai",
    "streaming": false,
    "params": {
      "max_tokens": 1024
    },
    "prompt": [
      {
        "role": "user",
        "content": "What is the weather like in San Francisco?"
      },
      {
        "role": "assistant",
        "content": ""
      },
      {
        "role": "user",
        "content": ""
      }
    ]
  }
}
