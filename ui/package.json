{
	"name": "agentgateway-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"build": "node scripts/generate-schema.mjs && tsc -b && vite build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev": "pnpm build && VITE_AGENTGATEWAY_API=http://localhost:15000 vite",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"generate-schema": "node scripts/generate-schema.mjs",
		"lint": "pnpm typecheck && pnpm check && pnpm test",
		"preview": "pnpm build && vite preview",
		"preview:e2e": "pnpm build --mode e2e && vite preview --mode e2e",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"typecheck": "pnpm generate-schema && tsc -b"
	},
	"dependencies": {
		"@fontsource/geist-sans": "=5.3.0",
		"@monaco-editor/react": "=4.7.0",
		"@tanstack/react-query": "=5.104.5",
		"@tanstack/react-router": "=1.170.45",
		"dompurify": "=3.4.17",
		"js-yaml": "=5.5.0",
		"lucide-react": "=1.60.0",
		"marked": "=18.1.1",
		"monaco-editor": "=0.57.0",
		"monaco-yaml": "=5.5.1",
		"react": "=19.3.1",
		"react-dom": "=19.3.1",
		"recharts": "=3.10.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "=1.64.1",
		"@types/node": "=26.6.5",
		"@types/react": "=19.3.0",
		"@types/react-dom": "=19.3.0",
		"@vitejs/plugin-react": "=6.1.2",
		"ajv": "=8.20.0",
		"json-schema-to-typescript": "=16.0.0",
		"typescript": "=7.0.2",
		"vite": "=8.3.4"
	},
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": "24.17.0"
	}
}
