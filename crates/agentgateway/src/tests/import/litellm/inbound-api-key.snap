---
source: crates/agentgateway/src/import.rs
description: src/tests/import/litellm/inbound-api-key.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: chat
        provider: openAI
        params:
          model: gpt-4o
    policies:
      apiKey:
        keys:
          - key: $LITELLM_MASTER_KEY
        mode: strict
        location:
          header:
            name: x-litellm-key
            prefix: "Bearer "
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: general_settings.master_key
    status: exact
    message: Mapped the environment-backed master_key and LiteLLM custom API-key header to strict inbound API-key authentication
  - sourcePath: general_settings.litellm_key_header_name
    status: exact
    message: "Mapped LiteLLM's custom API-key header name to the inbound API-key policy"
