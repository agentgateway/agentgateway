{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "formatter": { "indentStyle": "space" },
  "files": {
    "includes": [
      // Configuration and source files
      "src/**/*.ts",
      "src/**/*.tsx",
      "scripts/**/*.mjs",
      "*.ts",
      "*.js",
      "*.json",
      "*.jsonc",
      // Generated by `npm run generate-schema`
      "!src/cel.d.ts",
      "!src/gateway-admin.d.ts",
      "!src/gateway-config.d.ts"
    ]
  }
}
