---
source: crates/llm/src/ir_golden_tests.rs
description: src/tests/requests/messages/cache_control.json
info:
  model: gpt-5.6-terra
  max_tokens: 1024
  system:
    - type: text
      text: First system block
    - type: text
      text: Second system block
      cache_control:
        type: ephemeral
        ttl: 1h
  messages:
    - role: assistant
      content:
        - type: text
          text: First assistant block
        - type: text
          text: Second assistant block
          cache_control:
            type: ephemeral
            ttl: 1h
    - role: user
      content:
        - type: text
          text: Cached user text
          cache_control:
            type: ephemeral
            ttl: 5m
        - type: image
          source:
            type: base64
            media_type: image/png
            data: aGVsbG8=
          cache_control:
            type: ephemeral
            ttl: 5m
    - role: assistant
      content:
        - type: tool_use
          id: call_text
          name: lookup
          input: {}
        - type: tool_use
          id: call_array
          name: lookup
          input: {}
        - type: tool_use
          id: call_image
          name: lookup
          input: {}
        - type: tool_use
          id: call_mixed
          name: lookup
          input: {}
          cache_control:
            type: ephemeral
    - role: user
      content:
        - type: tool_result
          tool_use_id: call_text
          content: text result
          cache_control:
            type: ephemeral
        - type: tool_result
          tool_use_id: call_array
          content:
            - type: text
              text: array result
              cache_control:
                type: ephemeral
        - type: tool_result
          tool_use_id: call_image
          content:
            - type: image
              source:
                type: base64
                media_type: image/png
                data: aGVsbG8=
              cache_control:
                type: ephemeral
        - type: tool_result
          tool_use_id: call_mixed
          content:
            - type: text
              text: before image
            - type: image
              source:
                type: base64
                media_type: image/png
                data: aGVsbG8=
              cache_control:
                type: ephemeral
            - type: text
              text: after image
    - role: system
      content:
        - type: text
          text: System-role block
          cache_control:
            type: ephemeral
  tools:
    - name: lookup
      description: Look up information
      input_schema:
        type: object
        properties: {}
      cache_control:
        type: ephemeral
---
{
  "disposition": "changed: a mark on a part inside a tool result lands on the result's last part, where legacy marks that part; marks Responses has no place for are dropped and recorded",
  "request": {
    "model": "gpt-5.6-terra",
    "input": [
      {
        "type": "message",
        "role": "system",
        "content": [
          {
            "type": "input_text",
            "text": "First system block"
          },
          {
            "type": "input_text",
            "text": "Second system block",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      },
      {
        "type": "message",
        "role": "assistant",
        "content": [
          {
            "type": "output_text",
            "text": "First assistant block"
          },
          {
            "type": "output_text",
            "text": "Second assistant block",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      },
      {
        "type": "message",
        "role": "user",
        "content": [
          {
            "type": "input_text",
            "text": "Cached user text",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          },
          {
            "type": "input_image",
            "image_url": "data:image/png;base64,aGVsbG8=",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      },
      {
        "type": "function_call",
        "call_id": "call_text",
        "name": "lookup",
        "arguments": "{}"
      },
      {
        "type": "function_call",
        "call_id": "call_array",
        "name": "lookup",
        "arguments": "{}"
      },
      {
        "type": "function_call",
        "call_id": "call_image",
        "name": "lookup",
        "arguments": "{}"
      },
      {
        "type": "function_call",
        "call_id": "call_mixed",
        "name": "lookup",
        "arguments": "{}"
      },
      {
        "type": "function_call_output",
        "call_id": "call_text",
        "output": [
          {
            "type": "input_text",
            "text": "text result",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      },
      {
        "type": "function_call_output",
        "call_id": "call_array",
        "output": [
          {
            "type": "input_text",
            "text": "array result",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      },
      {
        "type": "function_call_output",
        "call_id": "call_image",
        "output": [
          {
            "type": "input_image",
            "image_url": "data:image/png;base64,aGVsbG8=",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      },
      {
        "type": "function_call_output",
        "call_id": "call_mixed",
        "output": [
          {
            "type": "input_text",
            "text": "before image"
          },
          {
            "type": "input_image",
            "image_url": "data:image/png;base64,aGVsbG8="
          },
          {
            "type": "input_text",
            "text": "after image",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      },
      {
        "type": "message",
        "role": "system",
        "content": [
          {
            "type": "input_text",
            "text": "System-role block",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      }
    ],
    "tools": [
      {
        "type": "function",
        "name": "lookup",
        "description": "Look up information",
        "parameters": {
          "type": "object",
          "properties": {}
        },
        "strict": false
      }
    ],
    "max_output_tokens": 1024,
    "store": false,
