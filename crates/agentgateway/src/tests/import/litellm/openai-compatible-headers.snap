---
source: crates/agentgateway/src/import.rs
description: src/tests/import/litellm/openai-compatible-headers.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: chat
        provider:
          reference: imported/litellm/openai-org
        params:
          model: gpt-4o
      - name: chat-with-overrides
        provider:
          reference: imported/litellm/openai-org
        params:
          model: gpt-4o-mini
        requestHeaders:
          set:
            openai-organization: $OPENAI_ORGANIZATION
            x-credential-header: model
            x-request-id: $REQUEST_ID
      - name: chat-with-empty-headers
        provider:
          reference: imported/litellm/openai-org
        params:
          model: gpt-4.1
        requestHeaders:
          set:
            openai-organization: $OPENAI_ORGANIZATION
      - name: chat-inline-with-overrides
        provider: openAI
        params:
          apiKey: $OPENAI_API_KEY
          model: gpt-4.1-mini
          baseUrl: "https://example.com/v1"
        requestHeaders:
          set:
            openai-organization: $OPENAI_ORGANIZATION
            x-inline: model
      - name: chat-inline-with-empty-headers
        provider: openAI
        params:
          apiKey: $OPENAI_API_KEY
          model: gpt-4.1-nano
          baseUrl: "https://example.com/v1"
        requestHeaders:
          set:
            openai-organization: $OPENAI_ORGANIZATION
      - name: chat-with-organization-override
        provider:
          reference: imported/litellm/openai-org
        params:
          model: o3
        requestHeaders:
          set:
            openai-organization: $MODEL_ORGANIZATION
            x-credential-header: credential
      - name: chat-inline-with-organization-override
        provider: openAI
        params:
          apiKey: $OPENAI_API_KEY
          model: o3-mini
          baseUrl: "https://example.com/v1"
        requestHeaders:
          set:
            openai-organization: $MODEL_ORGANIZATION
            x-credential-header: credential
      - name: chat-with-invalid-headers
        provider:
          reference: imported/litellm/openai-org
        params:
          model: gpt-5
        requestHeaders:
          set:
            openai-organization: $OPENAI_ORGANIZATION
      - name: chat-inline-with-invalid-headers
        provider: openAI
        params:
          apiKey: $OPENAI_API_KEY
          model: gpt-5-mini
          baseUrl: "https://example.com/v1"
        requestHeaders:
          set:
            openai-organization: $OPENAI_ORGANIZATION
      - name: chat-with-invalid-organization
        provider:
          reference: imported/litellm/openai-org
        params:
          model: gpt-5.1
        requestHeaders:
          set:
            x-credential-header: credential
      - name: chat-inline-with-empty-organization
        provider: openAI
        params:
          apiKey: $OPENAI_API_KEY
          model: gpt-5.1-mini
          baseUrl: "https://example.com/v1"
        requestHeaders:
          set:
            x-credential-header: credential
      - name: local
        provider: ollama
        params:
          model: llama3
          baseUrl: "http://localhost:11434/v1"
        requestHeaders:
          set:
            x-static: "yes"
    providers:
      - name: imported/litellm/openai-org
        provider: openAI
        params:
          apiKey: $OPENAI_API_KEY
        defaults:
          requestHeaders:
            set:
              openai-organization: $OPENAI_ORGANIZATION
              x-credential-header: credential
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: "credential_list[0].credential_values.organization"
    status: exact
    message: Mapped OpenAI organization to the upstream OpenAI-Organization header
  - sourcePath: "credential_list[0].credential_values.extra_headers.X-Credential-Header"
    status: exact
    message: "Mapped fixed upstream header \"x-credential-header\""
  - sourcePath: "credential_list[0]"
    status: exact
    message: "Imported supported values from LiteLLM credential \"openai-org\""
  - sourcePath: "model_list[0].litellm_params.litellm_credential_name"
    status: exact
    message: "Mapped LiteLLM credential \"openai-org\" to reusable agentgateway provider \"imported/litellm/openai-org\""
  - sourcePath: "model_list[1].litellm_params.extra_headers.X-Credential-Header"
