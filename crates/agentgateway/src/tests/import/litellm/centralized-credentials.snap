---
source: crates/agentgateway/src/import.rs
description: src/tests/import/litellm/centralized-credentials.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: chat
        provider:
          reference: imported/litellm/shared-openai
        params:
          model: gpt-4o
      - name: summarize
        provider:
          reference: imported/litellm/shared-openai
        params:
          model: gpt-4o-mini
        defaults:
          temperature: 0.2
    providers:
      - name: imported/litellm/shared-openai
        provider: openAI
        params:
          baseUrl: "https://api.openai.example/v1"
          apiKey: $OPENAI_API_KEY
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: "credential_list[0]"
    status: exact
    message: "Imported supported values from LiteLLM credential \"shared-openai\""
  - sourcePath: "model_list[0].litellm_params.litellm_credential_name"
    status: exact
    message: "Mapped LiteLLM credential \"shared-openai\" to reusable agentgateway provider \"imported/litellm/shared-openai\""
  - sourcePath: "model_list[1]"
    status: exact
    message: Imported model deployment for summarize
  - sourcePath: "model_list[1].litellm_params.litellm_credential_name"
    status: exact
    message: "Mapped LiteLLM credential \"shared-openai\" to reusable agentgateway provider \"imported/litellm/shared-openai\""
