{
	"name": "agentgateway-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/generate-schema.mjs && tsc -b && vite build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev": "pnpm build && VITE_AGENTGATEWAY_API=http://localhost:15000 vite",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"generate-schema": "node scripts/generate-schema.mjs",
		"lint": "pnpm typecheck && pnpm check",
		"preview": "pnpm build && vite preview",
		"preview:e2e": "pnpm build --mode e2e && vite preview --mode e2e",
		"test:e2e": "playwright test",
		"typecheck": "pnpm generate-schema && tsc -b"
	},
	"dependencies": {
		"@fontsource/geist-sans": "=5.3.0",
		"@monaco-editor/react": "=4.7.0",
		"@tanstack/react-query": "=5.101.4",
		"@tanstack/react-router": "=1.170.18",
		"js-yaml": "=5.2.3",
		"lucide-react": "=1.28.0",
		"monaco-editor": "=0.56.0",
		"monaco-yaml": "=5.5.1",
		"react": "=19.2.8",
		"react-dom": "=19.2.8",
		"recharts": "=3.10.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@playwright/test": "=1.62.1",
		"@types/node": "=24.13.3",
		"@types/react": "=19.2.18",
		"@types/react-dom": "=19.2.4",
		"@vitejs/plugin-react": "=6.0.5",
		"ajv": "=8.20.0",
		"json-schema-to-typescript": "=15.0.4",
		"typescript": "=7.0.2",
		"vite": "=8.2.0"
	},
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": "24.17.0"
	}
}
