---
# Source: agentgateway/templates/monitoring.yaml
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: test-release-agentgateway-proxy
  namespace: default
  labels:
    helm.sh/chart: agentgateway-0.0.2
    agentgateway: agentgateway
    app.kubernetes.io/name: agentgateway
    app.kubernetes.io/instance: test-release
    app.kubernetes.io/version: "0.0.0-dev"
    app.kubernetes.io/managed-by: Helm
    release: prometheus
spec:
  selector:
    matchExpressions:
    - key: gateway.networking.k8s.io/gateway-class-name
      operator: In
      values:
      - "agentgateway"
  namespaceSelector:
    matchNames:
    - default
  scrapeNativeHistograms: false
  scrapeClassicHistograms: true
  scrapeProtocols:
    - OpenMetricsText1.0.0
    - OpenMetricsText0.0.1
    - PrometheusText1.0.0
    - PrometheusText0.0.4
  podMetricsEndpoints:
  - port: metrics
    path: /metrics
    interval: 30s
  podTargetLabels:
    - gateway.networking.k8s.io/gateway-name

---
# Source: agentgateway/templates/monitoring.yaml
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: test-release-agentgateway
  namespace: default
  labels:
    helm.sh/chart: agentgateway-0.0.2
    agentgateway: agentgateway
    app.kubernetes.io/name: agentgateway
    app.kubernetes.io/instance: test-release
    app.kubernetes.io/version: "0.0.0-dev"
    app.kubernetes.io/managed-by: Helm
    release: prometheus
spec:
  selector:
    matchLabels:
      agentgateway: agentgateway
      app.kubernetes.io/name: agentgateway
      app.kubernetes.io/instance: test-release
  namespaceSelector:
    matchNames:
    - default
  scrapeNativeHistograms: false
  scrapeClassicHistograms: true
  scrapeProtocols:
    - OpenMetricsText1.0.0
    - OpenMetricsText0.0.1
    - PrometheusText1.0.0
    - PrometheusText0.0.4
  endpoints:
  - port: metrics
    path: /metrics
    interval: 30s
