---
source: crates/llm/src/golden_tests.rs
description: src/tests/requests/policies/openai_with_inputs.json
info:
  model: gpt-4o
  max_output_tokens: 1024
  input:
    - type: message
      role: user
      content:
        - type: input_text
          text: "Hello, world"
---
{
  "request": {
    "input": [
      {
        "type": "message",
        "content": [
          {
            "type": "input_text",
            "text": "prepend system prompt"
          }
        ],
        "role": "system"
      },
      {
        "type": "message",
        "content": [
          {
            "type": "input_text",
            "text": "prepend user message"
          }
        ],
        "role": "user"
      },
      {
        "type": "message",
        "role": "assistant",
        "content": "prepend assistant message"
      },
      {
        "type": "message",
        "role": "user",
        "content": [
          {
            "type": "input_text",
            "text": "Hello, world"
          }
        ]
      },
      {
        "type": "message",
        "content": [
          {
            "type": "input_text",
            "text": "append user message"
          }
        ],
        "role": "user"
      },
      {
        "type": "message",
        "content": [
          {
            "type": "input_text",
            "text": "append system prompt"
          }
        ],
        "role": "system"
      },
      {
        "type": "message",
        "role": "assistant",
        "content": "append assistant prompt"
      }
    ],
    "model": "gpt-4o",
    "max_output_tokens": 1024
  },
  "parsed": {
    "input_format": "Responses",
    "cache_convention": "InputIncludesCache",
    "request_model": "gpt-4o",
    "provider": "openai",
    "streaming": false,
    "params": {
      "max_tokens": 1024
    },
    "prompt": [
      {
        "role": "system",
        "content": "prepend system prompt"
      },
      {
        "role": "user",
        "content": "prepend user message"
      },
      {
        "role": "assistant",
        "content": "prepend assistant message"
      },
      {
        "role": "user",
        "content": "Hello, world"
      },
      {
        "role": "user",
        "content": "append user message"
      },
      {
        "role": "system",
        "content": "append system prompt"
      },
      {
        "role": "assistant",
        "content": "append assistant prompt"
      }
    ]
  }
