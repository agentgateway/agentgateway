# Public hostname for the NetBird dashboard and management API.
NETBIRD_MANAGEMENT_DOMAIN=netbird.example.com

# Private DNS suffix used for generated Agent Network endpoints. Do not create
# a public wildcard DNS record for this domain.
NETBIRD_PROXY_DOMAIN=agents.example.com

# Initial owner account. Use a strong password outside disposable testing.
NETBIRD_ADMIN_EMAIL=admin@example.com
NETBIRD_ADMIN_PASSWORD=replace-with-a-strong-password

# Provider credentials used by the private agentgateway listener.
OPENAI_API_KEY=replace-with-an-openai-key
ANTHROPIC_API_KEY=replace-with-an-anthropic-key

# Optional overrides. prepare.sh generates omitted application secrets.
# NETBIRD_VIRTUAL_KEY=
# NETBIRD_AUTH_SECRET=
# NETBIRD_SESSION_KEY=
# NETBIRD_STORE_KEY=
