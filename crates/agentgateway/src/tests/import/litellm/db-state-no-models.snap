---
source: crates/agentgateway/src/import/litellm.rs
description: src/tests/import/litellm/db-state-no-models.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  mcp:
    gateways: default
    targets:
      - mcp:
          host: "http://mcp-test-server:8081/mcp"
        name: test-tools
    policies:
      apiKey:
        keys:
          - keyHash: "sha256:abababababababababababababababababababababababababababababababab"
            metadata:
              name: no-models-key
          - key: sk-test-master-key
            metadata:
              name: master
        mode: strict
      mcpAuthorization:
        rules:
          - "(has(mcp.tool) && mcp.tool.target == \"test-tools\") || (has(mcp.prompt) && mcp.prompt.target == \"test-tools\") || (has(mcp.resource) && mcp.resource.target == \"test-tools\")"
          - "apiKey.name == \"master\""
findings:
  - sourcePath: mcp_servers.test_tools
    status: approximate
    message: "Renamed \"test_tools\" to \"test-tools\" to satisfy agentgateway's Gateway-API-style MCP target name pattern (lowercase letters, digits, '-', '.'; no underscores)"
  - sourcePath: mcp_servers.test_tools
    status: approximate
    message: "Mapped LiteLLM MCP server to agentgateway target \"test-tools\""
