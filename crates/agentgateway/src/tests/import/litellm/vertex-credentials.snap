---
source: crates/agentgateway/src/import.rs
description: src/tests/import/litellm/vertex-credentials.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: file
        provider: vertex
        params:
          model: gemini-2.5-flash
          vertexProject: example-project
          vertexRegion: us-central1
        auth:
          gcp:
            credential:
              file: /var/run/secrets/vertex/credentials.json
      - name: relative
        provider: vertex
        params:
          model: gemini-2.5-flash
          vertexProject: example-project
          vertexRegion: europe-west4
        auth:
          gcp:
            credential:
              file: secrets/credentials.json
      - name: ambient
        provider: vertex
        params:
          model: gemini-2.5-flash
          vertexProject: example-project
          vertexRegion: us-central1
      - name: shared
        provider:
          reference: imported/litellm/shared-vertex
        params:
          model: gemini-2.5-pro
        auth:
          gcp:
            credential:
              file: /var/run/secrets/vertex/shared.json
    providers:
      - name: imported/litellm/shared-vertex
        provider: vertex
        params:
          vertexProject: example-project
          vertexRegion: us-central1
findings:
  - sourcePath: "credential_list[0].credential_values.vertex_credentials"
    status: exact
    message: Mapped Vertex AI credential file to auth.gcp.credential
  - sourcePath: "model_list[0].litellm_params.vertex_credentials"
    status: exact
    message: Mapped Vertex AI credential file to auth.gcp.credential
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for file
  - sourcePath: "model_list[1].litellm_params.vertex_ai_credentials"
    status: approximate
    message: Mapped relative Vertex AI credential file to auth.gcp.credential; agentgateway resolves it against its own working directory
  - sourcePath: "model_list[1]"
    status: exact
    message: Imported model deployment for relative
  - sourcePath: "model_list[2]"
    status: exact
    message: Imported model deployment for ambient
  - sourcePath: "model_list[2].litellm_params.vertex_credentials"
    status: approximate
    message: "No Vertex AI credentials are configured, so agentgateway uses its application default credentials; LiteLLM would first use VERTEXAI_CREDENTIALS from its environment"
  - sourcePath: "model_list[3]"
    status: exact
    message: Imported model deployment for shared
  - sourcePath: "credential_list[0]"
    status: exact
    message: "Imported supported values from LiteLLM credential \"shared-vertex\""
  - sourcePath: "model_list[3].litellm_params.litellm_credential_name"
    status: exact
    message: "Mapped LiteLLM credential \"shared-vertex\" to reusable agentgateway provider \"imported/litellm/shared-vertex\""
  - sourcePath: "model_list[4].litellm_params.vertex_credentials"
    status: manual
    message: Inline Vertex AI credential JSON is not copied into generated configuration; store it in a file and reference the path. The model was not emitted
  - sourcePath: "model_list[5].litellm_params.vertex_credentials"
    status: manual
    message: Vertex AI credentials from an environment variable may be credential JSON or a file path and cannot be mapped safely. The model was not emitted
