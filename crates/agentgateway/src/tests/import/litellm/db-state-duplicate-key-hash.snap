---
source: crates/agentgateway/src/import/litellm.rs
description: src/tests/import/litellm/db-state-duplicate-key-hash.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: chat
        provider: openAI
        params:
          model: gpt-4o
    policies:
      apiKey:
        keys:
          - key: $LITELLM_MASTER_KEY
            metadata:
              name: master
          - keyHash: "sha256:dddd4444dddd4444dddd4444dddd4444dddd4444dddd4444dddd4444dddd4444"
            metadata:
              name: a-restricted
            allowedModels:
              - chat
        mode: strict
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: general_settings.master_key
    status: approximate
    message: "Mapped LiteLLM's master_key (an admin-equivalent credential, not a per-user virtual key) to strict Authorization Bearer authentication; LiteLLM also accepts other credential headers. Per-user virtual-key migration needs LiteLLM's database state, not config.yaml alone."
  - sourcePath: "db_state.keys[1]"
    status: unsupported
    message: "Key's key_hash is already used by db_state.keys[0]; agentgateway compiles keys by hash, so only one of them would ever take effect, and this one was not migrated"
  - sourcePath: "db_state.keys[0]"
    status: exact
    message: "Migrated key \"a-restricted\" to llm.policies.apiKey (hash-based, no plaintext)"
