{
  "title": "agentgateway Overview",
  "description": "Proxy and controller telemetry. Optional panels remain empty until matching traffic occurs. Cost includes only priced requests. Enable percentile aggregations on latency distributions.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "defaults": [
        "*"
      ]
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "title": "Requests per second",
        "requests": [
          {
            "q": "sum:agentgateway.requests.count{$env} by {status}.as_rate()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "HTTP failures (5xx) per second",
        "requests": [
          {
            "q": "sum:agentgateway.requests.count{$env,status:5*} by {route}.as_rate()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "HTTP latency p95 (enable distribution percentiles)",
        "requests": [
          {
            "q": "p95:agentgateway.request.duration{$env} by {route}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "LLM time to first token p95",
        "requests": [
          {
            "q": "p95:agentgateway.gen_ai.time_to_first_token{$env} by {request_model}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "LLM time per output token p95",
        "requests": [
          {
            "q": "p95:agentgateway.gen_ai.time_per_output_token{$env} by {request_model}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Tokens per second \u2014 input includes cache tokens",
        "requests": [
          {
            "q": "sum:agentgateway.gen_ai.token.usage.sum{$env} by {token_type}.as_rate()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Estimated USD per second \u2014 priced requests only",
        "requests": [
          {
            "q": "sum:agentgateway.gen_ai.cost.usd.count{$env} by {request_model}.as_rate()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Cost catalog outcomes \u2014 missing is not free",
        "requests": [
          {
            "q": "sum:agentgateway.cost_catalog.lookups.count{$env} by {status}.as_rate()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "MCP requests per second",
        "requests": [
          {
            "q": "sum:agentgateway.requests.count{$env,protocol:mcp} by {status}.as_rate()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Guardrail decisions",
        "requests": [
          {
            "q": "sum:agentgateway.guardrail.checks.count{$env} by {action}.as_count()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Controller reconciliations",
        "requests": [
          {
            "q": "sum:agentgateway.controller.reconciliations.count{$env} by {result}.as_rate()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Controller reconciliation duration p95",
        "requests": [
          {
            "q": "p95:agentgateway.controller.reconcile.duration{$env} by {controller}",
            "display_type": "line"
          }
        ]
      }
    }
  ]
}
