---
source: crates/agentgateway/src/types/local_tests.rs
description: "Config normalization test for llm_active_health: YAML -> LocalConfig -> NormalizedLocalConfig -> YAML"
---
binds:
  - key: bind/4000
    address: "[::]:4000"
    protocol: http
    tunnelProtocol: direct
    mode: standard
    listeners:
      llm:
        gatewayName: name
        gatewayNamespace: ns
        hostname: "*"
        key: llm
        listenerName: llm
        protocol: HTTP
listener_routes:
  - - llm
    - - backends:
          - backend: "/llm:router"
            weight: 1
        key: "llm:request"
        matches:
          - path:
              pathPrefix: /
        name: "llm:request"
        namespace: internal
listener_tcp_routes:
  - - llm
    - []
policies: []
backends:
  - backend:
      ai:
        name: "llm:model:qwen3:0"
        namespace: ""
        target:
          providers:
            - active:
                qwen3:
                  endpoint:
                    name: qwen3
                    provider:
                      custom:
                        model: Qwen/Qwen3-32B
                        providerOverride: vllm-shared
                        formats:
                          - type: completions
                            path: ~
                    hostOverride: "vllm.internal:8000"
                    pathOverride: ~
                    pathPrefix: /v1
                    tokenize: false
                  info:
                    health: 1
                    requestLatency: 0
                    pendingRequests: 0
                    totalRequests: 0
                    consecutiveFailures: 0
                    timesEjected: 0
                    evictedUntil: ~
                  capacity: 1
              rejected: {}
    inlinePolicies:
      - health:
          active:
            path: /health
            interval: 5s
            timeout: 2s
            healthyThreshold: 1
            unhealthyThreshold: 2
      - ai: {}
  - backend:
      ai:
        name: "llm:model:llama:1"
        namespace: ""
        target:
          providers:
            - active:
                llama:
                  endpoint:
                    name: llama
                    provider:
                      custom:
                        formats:
                          - type: completions
                            path: ~
                    hostOverride: "llama.internal:8000"
                    pathOverride: ~
                    pathPrefix: /v1
                    tokenize: false
                  info:
                    health: 1
                    requestLatency: 0
                    pendingRequests: 0
                    totalRequests: 0
                    consecutiveFailures: 0
                    timesEjected: 0
                    evictedUntil: ~
                  capacity: 1
              rejected: {}
    inlinePolicies:
      - health:
          unhealthyExpression: response.code >= 500
          eviction:
            duration: 30s
            restoreHealth: 1
          active:
            path: /health
            interval: 15s
            timeout: 3s
            healthyThreshold: 2
            unhealthyThreshold: 3
            expectedStatuses:
              - 200
              - 204
      - ai: {}
  - backend:
      llmRouter:
        name: "llm:router"
        namespace: ""
        target:
          models:
            - name: qwen3
              created: 0
              visibility: public
              headerMatches: []
              backend:
                backend: "/llm:model:qwen3:0"
                weight: 1
              policies:
                llm:
                  routes:
                    "*": passthrough
                    /v1/chat/completions: completions
                    /v1/embeddings: embeddings
                    /v1/images/edits: detect
                    /v1/images/generations: detect
                    /v1/images/variations: detect
                    /v1/messages: messages
                    /v1/messages/count_tokens: anthropicTokenCount
                    /v1/rerank: rerank
                    /v1/responses: responses
                    /v1/responses/compact: detect
                    /v2/rerank: rerank
                    ":countTokens": geminiCountTokens
                    ":generateContent": generateContent
                    ":rawPredict": messages
                    ":streamGenerateContent": generateContent
                    ":streamRawPredict": messages
                authorization: ~
              backendPolicies: []
            - name: llama
              created: 0
              visibility: public
              headerMatches: []
              backend:
                backend: "/llm:model:llama:1"
                weight: 1
              policies:
                llm:
                  routes:
                    "*": passthrough
                    /v1/chat/completions: completions
                    /v1/embeddings: embeddings
                    /v1/images/edits: detect
                    /v1/images/generations: detect
                    /v1/images/variations: detect
                    /v1/messages: messages
                    /v1/messages/count_tokens: anthropicTokenCount
                    /v1/rerank: rerank
                    /v1/responses: responses
                    /v1/responses/compact: detect
                    /v2/rerank: rerank
                    ":countTokens": geminiCountTokens
                    ":generateContent": generateContent
                    ":rawPredict": messages
                    ":streamGenerateContent": generateContent
                    ":streamRawPredict": messages
                authorization: ~
              backendPolicies: []
          virtualModels: []
route_groups: []
workloads: []
services: []
