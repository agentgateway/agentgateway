info:
  model: gemini-2.5-pro
  messages:
    - role: user
      content: Weather in Columbus and Berlin?
    - role: assistant
      content: ~
      tool_calls:
        - id: call_1
          type: function
          function:
            name: get_weather
            arguments: "{\"location\":\"Columbus\"}"
    - role: tool
      tool_call_id: call_1
      name: get_weather
      content: "{\"temp\":15}"
