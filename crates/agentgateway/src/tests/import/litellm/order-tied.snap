---
source: crates/agentgateway/src/import/litellm.rs
description: src/tests/import/litellm/order-tied.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: imported/litellm/chat/1
        visibility: internal
        provider: bedrock
        params:
          model: anthropic.claude-sonnet-5
          awsRegion: eu-west-2
      - name: imported/litellm/chat/2
        visibility: internal
        provider: bedrock
        params:
          model: anthropic.claude-opus-5-5
          awsRegion: eu-west-2
    virtualModels:
      - name: chat
        routing:
          weighted:
            targets:
              - model: imported/litellm/chat/1
                weight: 1
              - model: imported/litellm/chat/2
                weight: 1
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: "model_list[1]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: general_settings.master_key
    status: manual
    message: "No master_key in config.yaml; if LiteLLM authenticates from the LITELLM_MASTER_KEY environment variable directly (common in Docker deployments), this importer can't see it from config.yaml alone. Set general_settings.master_key: os.environ/LITELLM_MASTER_KEY to make it visible"
