      content: ~
      tool_calls:
        - id: call_2
          type: function
          function:
            name: get_weather
            arguments: "{\"location\":\"Berlin\"}"
    - role: tool
      tool_call_id: call_2
      name: get_weather
      content: "{\"temp\":9}"
