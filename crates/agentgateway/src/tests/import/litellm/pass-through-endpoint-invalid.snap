---
source: crates/agentgateway/src/import/litellm.rs
description: src/tests/import/litellm/pass-through-endpoint-invalid.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: gpt-4o
        provider: openAI
        params:
          model: gpt-4o
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for gpt-4o
  - sourcePath: general_settings.master_key
    status: manual
    message: "No master_key in config.yaml; if LiteLLM authenticates from the LITELLM_MASTER_KEY environment variable directly (common in Docker deployments), this importer can't see it from config.yaml alone. Set general_settings.master_key: os.environ/LITELLM_MASTER_KEY to make it visible"
  - sourcePath: "general_settings.pass_through_endpoints[0].path"
    status: manual
    message: "LiteLLM pass-through path must start with '/' and was not emitted"
  - sourcePath: "general_settings.pass_through_endpoints[1].target"
    status: manual
    message: LiteLLM pass-through endpoint has no target and was not emitted
  - sourcePath: "general_settings.pass_through_endpoints[2].target"
    status: manual
    message: "LiteLLM pass-through target \"not a url\" is not a valid URL (relative URL without a base) and was not emitted"
  - sourcePath: "general_settings.pass_through_endpoints[3].target"
    status: unsupported
    message: "LiteLLM pass-through target scheme \"ftp\" is not supported and was not emitted"
