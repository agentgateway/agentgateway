            - type: text
              text: after image
    - role: system
      content:
        - type: text
          text: System-role block
          cache_control:
            type: ephemeral
  tools:
    - name: lookup
      description: Look up information
      input_schema:
        type: object
        properties: {}
      cache_control:
        type: ephemeral
