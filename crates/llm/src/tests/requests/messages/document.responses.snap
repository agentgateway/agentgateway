            data: Payment is due in 30 days.
        - type: text
          text: "Compare these documents, then fetch report r-1."
    - role: assistant
      content:
        - type: tool_use
          id: toolu_01
          name: fetch_report
          input:
            id: r-1
    - role: user
      content:
        - type: tool_result
          tool_use_id: toolu_01
          content:
            - type: text
              text: "Report r-1:"
            - type: document
              title: r-1.pdf
              source:
                type: base64
                media_type: application/pdf
                data: JVBERi0xLjQK
