---
source: crates/agentgateway/src/import.rs
description: src/tests/import/litellm/inbound-api-key-master-key-in-environment-variables.yaml
---
source: litellm
config:
  config:
    database:
      url: "sqlite://data.db"
  gateways:
    default:
      port: 4000
  ui:
    gateways: default
  llm:
    gateways: default
    models:
      - name: chat
        provider: openAI
        params:
          model: gpt-4o
findings:
  - sourcePath: "model_list[0]"
    status: exact
    message: Imported model deployment for chat
  - sourcePath: general_settings.master_key
    status: manual
    message: "No master_key in config.yaml, but environment_variables.LITELLM_MASTER_KEY is set; LiteLLM loads environment_variables into its own process environment at startup, so that value is very likely the real master_key. This importer does not read environment_variables for security-sensitive values automatically; copy it into general_settings.master_key (or add general_settings.master_key: os.environ/LITELLM_MASTER_KEY if you'd rather keep the literal value out of config.yaml) to make it visible"
  - sourcePath: environment_variables.LITELLM_MASTER_KEY
    status: manual
    message: Requires manual review and was not emitted
